# --- Database ---------------------------------------------------------------
# Postgres (e.g. Neon). Format:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# For local dev you can run any Postgres instance and point this at it.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- AI ---------------------------------------------------------------------
# Free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional override; defaults to gemini-flash-latest
# GEMINI_MODEL="gemini-2.5-flash"

# --- Auth (Clerk) -----------------------------------------------------------
# Create a free app at https://dashboard.clerk.com, then copy the API keys
# from API Keys -> Show API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk's hosted pages and the local <SignIn/>/<SignUp/> components live.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
