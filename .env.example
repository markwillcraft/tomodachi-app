# --- Database ---------------------------------------------------------------
# Postgres (e.g. Neon). Format:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# For local dev you can run any Postgres instance and point this at it.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- AI ---------------------------------------------------------------------
# Free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional override; defaults to gemini-flash-latest
# GEMINI_MODEL="gemini-2.5-flash"

# --- Auth (Clerk) -----------------------------------------------------------
# Create a free app at https://dashboard.clerk.com, then copy the API keys
# from API Keys -> Show API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk's hosted pages and the local <SignIn/>/<SignUp/> components live.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Rate limiting (Upstash Redis) ------------------------------------------
# Optional in local dev — when unset, src/lib/rate-limit.ts becomes a no-op
# and every request passes through. REQUIRED in production to protect the
# Gemini bill and the database from runaway scripts. Create a free Redis DB
# at https://console.upstash.com (10k commands/day free tier covers ~5k DAU)
# then copy the REST URL and REST TOKEN from the database "REST API" tab.
UPSTASH_REDIS_REST_URL="https://optimum-scorpion-106002.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAZ4SAAIgcDFjMGQ2MmJiYzcyZjg0ZTUyOTkyNWNhMDZiNzkxZDZiOQ"
